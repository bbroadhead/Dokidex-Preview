<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const button = document.querySelector('.yv-links-dropdown .links-button');
    const menu = document.querySelector('.yv-links-dropdown .dropdown-content');
    if (button && menu) {
      const close = () => { menu.classList.remove('show'); button.setAttribute('aria-expanded','false'); };
      button.addEventListener('click', e => {
        e.preventDefault();
        const opening = !menu.classList.contains('show');
        menu.classList.toggle('show', opening);
        button.setAttribute('aria-expanded',String(opening));
      });
      document.addEventListener('click', e => {
        if (!button.contains(e.target) && !menu.contains(e.target)) close();
      });
      document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
      menu.addEventListener('click', e => { if (e.target.closest('a')) close(); });
    }
  });
</script>
<script>
let radarChart;

function createRadarChart() {
  const canvas = document.getElementById('statRadarChart');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (radarChart) radarChart.destroy();
  radarChart = new Chart(ctx, {
    type: 'radar',
    data: {
      labels: ['HP', 'ATK', 'DEF', 'M.ATK', 'M.DEF', 'SPD'],
      datasets: [{
        label: 'index.md.bak',
        data: null,
        backgroundColor: 'rgba(136, 136, 136, 0.2)', // light gray fill
        borderColor: '#888', // neutral edge
        pointBackgroundColor: [
          '#f66', // HP
          '#f90', // ATK
          '#fc3', // DEF
          '#99f', // M.ATK
          '#6cf', // M.DEF
          '#3cba54'  // SPD
        ],
        pointBorderColor: [
          '#f66', // HP
          '#f90', // ATK
          '#fc3', // DEF
          '#99f', // M.ATK
          '#6cf', // M.DEF
          '#3cba54'  // SPD
        ],
        pointRadius: 5,
        pointHoverRadius: 6,
        borderWidth: 2
      }]
    },
options: {
  responsive: false,
  scales: {
    r: {
      suggestedMin: 0,
      suggestedMax: 177,
      ticks: {
        backdropColor: 'transparent',
        color: "#ffffff",
        font: {
          weight: 'bold'
        }
      },
      pointLabels: {
        font: {
          weight: 'bold'
        },
        color: function(context) {
          const colors = ['#f66', '#f90', '#fc3', '#99f', '#6cf', '#3cba54'];
          return colors[context.index];
        }
      },
      grid: {
        color: document.body.classList.contains("dark-mode") ? "#ffffff" : "#bbbbbb",
      }
    }
  },
  plugins: {
    legend: {
      display: false
    }
  }
}
  });
}
createRadarChart();
</script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const tabs = document.querySelectorAll('.tab-button');
    const contents = document.querySelectorAll('.tab-content');

    if (tabs.length && contents.length) {
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => t.classList.remove('active'));
          contents.forEach(c => c.classList.remove('active'));
          tab.classList.add('active');
          document.getElementById(tab.dataset.tab).classList.add('active');
        });
      });
    }
  });
</script>
<script>
(function () {
  // Keep the dark background painted during navigation, including the first frame.
  const motionOK = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const navKey = 'yanoverse-monster-navigation';
  let navigating = false;
  try {
    if (sessionStorage.getItem(navKey) === '1') {
      document.documentElement.classList.add('monster-arriving');
      sessionStorage.removeItem(navKey);
    }
  } catch (_) {}
  function reveal() {
    document.documentElement.classList.remove('monster-arriving');
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => requestAnimationFrame(reveal), {once:true});
  } else requestAnimationFrame(reveal);
  window.addEventListener('pageshow', reveal);
  document.querySelectorAll('.nav-arrow').forEach(link => {
    link.addEventListener('click', event => {
      if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0 || navigating) return;
      event.preventDefault();
      navigating = true;
      try { sessionStorage.setItem(navKey, '1'); } catch (_) {}
      if (motionOK) document.documentElement.classList.add('monster-leaving');
      window.setTimeout(() => { window.location.assign(link.href); }, motionOK ? 90 : 0);
    });
  });
})();
</script>
<script>
document.addEventListener("DOMContentLoaded", function () {
  const mainImage = document.getElementById("main-monster-image");
  const altImages = document.querySelectorAll(".forms-images img");
  const lockButton = document.getElementById("lockImageBtn");
  const resetButton = document.getElementById("resetToDefaultBtn");

  if (!mainImage || !lockButton || !resetButton) {
    return;
  }

  const monsterName = mainImage?.dataset?.name;
  const defaultImage = mainImage?.dataset?.default;
  const localStorageKey = `dokimon_locked_image_${monsterName}`;
  const lockStateKey = `dokimon_lock_state_${monsterName}`;

  function updateLockVisualState(isLocked) {
    lockButton.textContent = isLocked ? '🔒' : '🔓';
    lockButton.setAttribute('aria-pressed', isLocked);
  }

  // Load from localStorage on page load
  const savedImage = localStorage.getItem(localStorageKey);
  const savedLockState = localStorage.getItem(lockStateKey) === 'true';

  if (savedImage) {
    mainImage.src = savedImage;
  }

  updateLockVisualState(savedLockState);

  // Click rare form images
  altImages.forEach(img => {
    img.addEventListener("click", () => {
      const isLocked = lockButton.getAttribute('aria-pressed') === 'true';
      if (isLocked) return;
      mainImage.src = img.src;
    });
  });

  // Toggle lock button
  lockButton.addEventListener("click", () => {
    const isLocked = lockButton.getAttribute('aria-pressed') === 'true';
    const newLocked = !isLocked;

    updateLockVisualState(newLocked);
    localStorage.setItem(lockStateKey, newLocked);

    if (newLocked) {
      localStorage.setItem(localStorageKey, mainImage.src);
    } else {
      localStorage.removeItem(localStorageKey);
    }
  });

  // Default reset
  resetButton.addEventListener("click", () => {
    mainImage.src = defaultImage;
    localStorage.removeItem(localStorageKey);
    localStorage.setItem(lockStateKey, false);
    updateLockVisualState(false);
  });
});
</script>
<script>
  if (window.location.search.includes('panel=1')) {
    document.body.classList.add('in-panel');
  }
</script>
<script>
  if (window.location.search.includes('panel=1')) {
    // Add 'in-panel' class to body for CSS control
    document.body.classList.add('in-panel');

    // Modify all internal links to preserve ?panel=1
    document.querySelectorAll('a[href^="/dokimon/"]').forEach(link => {
      if (!link.href.includes('panel=1')) {
        link.href += link.href.includes('?') ? '&panel=1' : '?panel=1';
      }
    });
  }
  document.body.classList.add('loading');
window.addEventListener('DOMContentLoaded', () => {
  document.body.classList.remove('loading');
});
</script>
<script>
  if (window.location.search.includes('panel=1')) {
    document.body.classList.add('in-panel');
  }
</script>
<script src="/assets/js/movesets.js"></script>
<script>
const moveData = {
  
  
};

function toggleMoveList() {
  const dropdown = document.getElementById("move-list-dropdown");
  const button = document.querySelector(".move-toggle-btn");
  const isOpen = dropdown.classList.toggle("show");

  if (isOpen) {
    dropdown.dataset.loaded = "true";
    button.innerHTML = "Move List + Lvls ▲";
    loadMoveList();
  } else {
    button.innerHTML = "Move List + Lvls ▼";
  }
}

function loadMoveList() {
  const monsterName = "index.md.bak";
  const moveList = MOVESETS[monsterName];

  if (!moveList) return;

  const ul = document.getElementById("move-list-content");
  ul.replaceChildren();
  [...moveList]
    .sort((a, b) => a.level - b.level)
    .forEach(entry => {
      const li = document.createElement("li");
      const moveName = entry.move.replace(/_/g, " ");  // Replace underscores
      li.textContent = `Lv ${entry.level}: ${moveName}`;
      ul.appendChild(li);
    });
}
</script>


