  <meta charset="UTF-8">
  <title>Dokimon:Quest - Wiki</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/styles.css">
  <link rel="icon" type="image/png" href="/assets/images/favicon.png">
  <link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">
<style id="yanoverse-critical-styles">
.yanoverse-brand{background:transparent!important;color:#aab8ce!important;text-align:center!important;font:600 11px/1.5 system-ui,sans-serif!important;letter-spacing:.16em!important;padding:10px 12px!important}
.yanoverse-game-picker{display:block!important;overflow:hidden!important;padding:12px 8px!important;background:transparent!important;border:0!important;max-width:100vw!important}
.yanoverse-game-track{display:flex!important;align-items:center!important;gap:10px!important;overflow-x:auto!important;scroll-snap-type:x mandatory!important;scrollbar-width:none!important;max-width:100%!important;margin:auto!important;padding:12px 6px!important;box-sizing:border-box!important}
.yanoverse-game{box-sizing:border-box!important;flex:0 0 145px!important;width:145px!important;min-width:0!important;height:110px!important;min-height:0!important;max-height:110px!important;display:flex!important;flex-direction:column!important;justify-content:center!important;align-items:center!important;gap:5px!important;padding:10px!important;border:1px solid rgba(153,177,208,.28)!important;border-radius:12px!important;background:rgba(135,165,205,.035)!important;color:inherit!important;filter:grayscale(1)!important;opacity:.56!important;transform:scale(.92)!important;box-shadow:none!important;overflow:hidden!important;cursor:pointer!important;scroll-snap-align:center!important;transition:transform .25s,opacity .25s,filter .25s!important}
.yanoverse-game.is-selected{flex-basis:210px!important;width:210px!important;height:124px!important;max-height:124px!important;background:rgba(135,165,205,.07)!important;border-color:rgba(149,190,241,.5)!important;filter:none!important;opacity:1!important;transform:scale(1)!important}
.yanoverse-game img{display:block!important;max-width:100%!important;width:auto!important;height:auto!important;max-height:67px!important;object-fit:contain!important;border:0!important;border-radius:0!important;box-shadow:none!important;flex-shrink:1!important}
.yanoverse-game-title{font:700 13px/1.2 system-ui,sans-serif!important;text-align:center!important}
.yanoverse-game.is-selected .yanoverse-game-title{font-size:14px!important}
.yanoverse-game small{font:600 9px/1.2 system-ui,sans-serif!important}
@media(max-width:600px){.yanoverse-game-picker{padding:7px 0!important}.yanoverse-game-track{padding:8px calc(50vw - 100px)!important;gap:8px!important}.yanoverse-game{flex-basis:125px!important;width:125px!important;height:90px!important;max-height:90px!important}.yanoverse-game.is-selected{flex-basis:200px!important;width:200px!important;height:108px!important;max-height:108px!important}.yanoverse-game img{max-height:56px!important}}
</style>
<style id="yanoverse-dex-card-fix">
/* Critical Dex card styles: load after legacy theme CSS. */
#dex-grid.dex-grid{display:grid!important;grid-template-columns:repeat(auto-fill,minmax(170px,1fr))!important;gap:14px!important;padding:14px!important}
#dex-grid .dex-entry{position:relative!important;isolation:isolate!important;box-sizing:border-box!important;min-width:0!important;min-height:205px!important;height:auto!important;overflow:hidden!important;border:1px solid rgba(154,186,220,.3)!important;border-radius:13px!important;background:linear-gradient(145deg,rgba(41,57,77,.8),rgba(17,25,39,.9) 62%,rgba(30,42,59,.8))!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.12),0 8px 24px rgba(0,0,0,.2)!important;backdrop-filter:blur(12px)!important;-webkit-backdrop-filter:blur(12px)!important;transition:transform .24s ease,box-shadow .24s ease!important}
#dex-grid .dex-entry::before{content:""!important;display:block!important;position:absolute!important;inset:0!important;pointer-events:none!important;z-index:0!important;background:linear-gradient(115deg,transparent 9%,rgba(255,255,255,.075) 24%,rgba(255,255,255,.018) 39%,transparent 57%)!important;opacity:.8!important;transform:translateX(-8%)!important;transition:transform .4s ease!important}
#dex-grid .dex-entry>a{position:relative!important;z-index:1!important;display:flex!important;flex-direction:column!important;align-items:stretch!important;gap:12px!important;height:100%!important;box-sizing:border-box!important;padding:12px!important;text-decoration:none!important}
#dex-grid .dex-entry .img-wrapper{display:flex!important;justify-content:center!important;align-items:center!important;align-self:center!important;box-sizing:border-box!important;width:120px!important;height:120px!important;max-width:100%!important;border-radius:10px!important;background:rgba(9,17,30,.28)!important;overflow:hidden!important}
#dex-grid .dex-entry img.monster-image.small{display:block!important;width:100%!important;height:100%!important;max-width:112px!important;max-height:112px!important;object-fit:contain!important;image-rendering:pixelated!important}
#dex-grid .dex-entry .dex-card-details{display:flex!important;flex-direction:column!important;align-items:flex-start!important;gap:5px!important;margin-top:auto!important;min-width:0!important;text-align:left!important}
#dex-grid .dex-entry .dex-card-number{font:700 12px/1.3 system-ui,sans-serif!important;color:#86baff!important;text-decoration:none!important}
#dex-grid .dex-entry .dex-card-name{font:750 15px/1.3 system-ui,sans-serif!important;color:#f5f8ff!important;text-decoration:none!important;overflow-wrap:anywhere!important}
@media(hover:hover) and (pointer:fine){#dex-grid .dex-entry:hover{transform:translateY(-4px) scale(1.012)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.18),0 13px 28px rgba(0,0,0,.28)!important}#dex-grid .dex-entry:hover::before{transform:translateX(9%)!important}}
#dex-grid .dex-entry:active{transform:scale(.98)!important}
@media(max-width:600px){#dex-grid.dex-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:10px!important;padding:10px!important}#dex-grid .dex-entry{min-height:190px!important}#dex-grid .dex-entry>a{padding:9px!important}#dex-grid .dex-entry .img-wrapper{width:100px!important;height:100px!important}#dex-grid .dex-entry .dex-card-name{font-size:13px!important}}
@media(prefers-reduced-motion:reduce){#dex-grid .dex-entry,#dex-grid .dex-entry::before{transition:none!important}#dex-grid .dex-entry:hover,#dex-grid .dex-entry:active{transform:none!important}}
</style>
<style id="yanoverse-modern-ui">
/* Unified responsive site shell; scoped to the development layout. */
:root{--yv-panel:rgba(17,27,43,.83);--yv-line:rgba(159,187,220,.19);--yv-muted:#a7b7ca;--yv-accent:#8bbdff}
html{scroll-padding-top:80px}
body{overflow-x:hidden}
body.dark-mode{background-color:#090f1a!important;background-image:radial-gradient(ellipse at 50% -10%,rgba(49,87,141,.19),transparent 55%),linear-gradient(135deg,#0a111d,#101a29 58%,#0a111a)!important;color:#edf3fc!important}
body.dark-mode::before{pointer-events:none}
.site-header{position:relative!important;z-index:20!important;max-width:100%!important;background:rgba(8,14,24,.91)!important;border-bottom:1px solid var(--yv-line)!important;box-shadow:0 6px 25px rgba(0,0,0,.16)!important}
.site-header .site-nav{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:12px!important;flex-wrap:wrap!important;width:100%!important;max-width:1240px!important;box-sizing:border-box!important;margin:0 auto!important;padding:10px 16px!important;background:transparent!important}
.site-header .nav-left{display:flex!important;flex:1 1 auto!important;align-items:center!important;flex-wrap:wrap!important;gap:7px!important;min-width:0!important}
.site-header .nav-center{display:flex!important;align-items:center!important;justify-content:center!important;flex:0 0 auto!important}
.site-header .nav-right{display:flex!important;align-items:center!important;justify-content:flex-end!important;gap:7px!important;flex-wrap:wrap!important}
.site-header .nav-button{display:inline-flex!important;align-items:center!important;justify-content:center!important;min-height:38px!important;box-sizing:border-box!important;padding:8px 13px!important;border:1px solid var(--yv-line)!important;border-radius:9px!important;background:rgba(139,177,222,.08)!important;color:#e5edf8!important;text-decoration:none!important;font:650 13px/1.2 system-ui,sans-serif!important;letter-spacing:0!important;white-space:nowrap!important;transition:background .2s,border-color .2s,transform .2s!important}
.site-header .nav-button:hover,.site-header .nav-button:focus-visible{background:rgba(139,177,222,.19)!important;border-color:rgba(154,196,250,.5)!important}
.site-header .search-and-toggle{display:flex!important;align-items:center!important;gap:9px!important;width:auto!important}
.site-header .theme-label{font:700 10px system-ui,sans-serif!important;text-transform:uppercase!important;letter-spacing:.1em!important;color:var(--yv-muted)!important}
.site-header .theme-switch-wrapper{margin:0!important}
.site-header .lang-flag{display:inline-flex!important;align-items:center!important;justify-content:center!important;width:29px!important;height:29px!important;margin:0!important;border-radius:50%!important;cursor:pointer!important;font-size:19px!important}
.site-header .dropdown-content{border:1px solid var(--yv-line)!important;border-radius:11px!important;background:#142238!important;box-shadow:0 16px 35px rgba(0,0,0,.35)!important;overflow:hidden!important;z-index:50!important}
.site-header .dropdown-content a{font:500 13px/1.4 system-ui,sans-serif!important;padding:10px 14px!important}
.page-content{box-sizing:border-box!important;max-width:1240px!important;width:100%!important;margin:0 auto!important;padding:20px 20px 60px!important}
body.dark-mode .filter-controls{box-sizing:border-box!important;max-width:100%!important;display:flex!important;flex-wrap:wrap!important;align-items:flex-end!important;gap:14px!important;padding:18px!important;border:1px solid var(--yv-line)!important;border-radius:14px!important;background:var(--yv-panel)!important;box-shadow:0 8px 28px rgba(0,0,0,.12)!important}
.filter-controls .filter-block{min-width:0!important}
.filter-controls label{display:block!important;margin-bottom:7px!important;color:var(--yv-muted)!important;font:700 11px/1.3 system-ui,sans-serif!important;letter-spacing:.06em!important;text-transform:uppercase!important}
.filter-controls input,.filter-controls select{box-sizing:border-box!important;max-width:100%!important;min-height:38px!important;border:1px solid rgba(158,188,226,.24)!important;border-radius:9px!important;padding:8px 10px!important;font:500 13px system-ui,sans-serif!important}
body.dark-mode .filter-controls input,body.dark-mode .filter-controls select{background:#101d2e!important;color:#eaf2ff!important}
#filter-toggle,#clear-filters{min-height:38px!important;border-radius:9px!important;padding:9px 14px!important;font:650 13px system-ui,sans-serif!important;cursor:pointer!important}
#filter-toggle{margin:0 0 14px!important}
#type-filters{display:flex!important;flex-wrap:wrap!important;gap:7px!important}
#type-filters .type-btn{border-radius:8px!important;padding:8px 11px!important;font:700 12px system-ui,sans-serif!important;letter-spacing:0!important;min-height:34px!important;box-shadow:none!important;transition:filter .2s,transform .2s!important}
#type-filters .type-btn:hover{filter:brightness(1.12);transform:translateY(-1px)}
#dex-grid .dex-entry .dex-card-name,#dex-grid .dex-entry .dex-card-number{text-decoration:none!important}
.yanoverse-game-picker{background:transparent!important}
.yanoverse-brand{background:transparent!important}
@media(max-width:700px){
.site-header .site-nav{gap:10px!important;padding:10px 12px!important}
.site-header .nav-left{order:1!important;flex:1 1 100%!important;justify-content:center!important;gap:6px!important}
.site-header .nav-center{order:2!important;flex:1 1 auto!important;justify-content:flex-start!important}
.site-header .nav-right{order:3!important;flex:0 1 auto!important;justify-content:flex-end!important}
.site-header .nav-button{min-height:36px!important;padding:8px 11px!important;font-size:12px!important}
.site-header .lang-flag{width:25px!important;height:25px!important;font-size:16px!important}
.page-content{padding:14px 12px 44px!important}
body.dark-mode .filter-controls{gap:12px!important;padding:13px!important}
.filter-controls .separator{display:none!important}
.filter-controls .filter-block{flex:1 1 130px!important}
.filter-controls .type-block{flex:1 1 100%!important}
#type-filters .type-btn{padding:7px 9px!important;font-size:11px!important}
}
@media(prefers-reduced-motion:reduce){.site-header .nav-button,#type-filters .type-btn{transition:none!important}}
</style>
